PORT=4000

# Optional: configure these to have the contact form send real emails.
# If left unset, submissions are still saved to server/data/submissions.json.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
CONTACT_TO_EMAIL=info@akakiKality.gov.et

# Internal chat (/employee/chat) needs two Firebase Admin SDK service-
# account keys saved as actual files (NOT env vars — see
# server/routes/chat-token.js), both already gitignored:
#   server/serviceAccountKey.employee.json  — Employee project, verifies
#     an employee's session before minting a chat token for them.
#   server/serviceAccountKey.chat.json      — mesob-chat project, mints
#     that chat-project custom token.
# Download each from Firebase Console → Project settings → Service
# accounts → Generate new private key, for the respective project.
# Chat is unavailable (rest of the Employee Portal still works) until
# both files are in place.
