# Chat server (Express + Socket.IO + SQLite).
# Runs alongside the main site's API server in ../server; the client
# reaches this one on the /chat-api prefix. Copy to .env and edit.

PORT=3000

# Signs the chat session JWTs. Must be long and random in production —
# anyone holding it can mint a session as any chat user.
JWT_SECRET=replace-this-with-a-long-random-string

# Where the SQLite database and uploaded attachments live. Defaults to
# chat.db / uploads/ inside this folder.
# DB_PATH=./chat.db
# UPLOAD_DIR=./uploads

# Self-service sign-up. The chat app's own sign-up form was removed when
# it moved to the shared /login screen, so this is closed by default —
# leaving it open would let anyone who can reach the server create an
# account on an internal staff chat. Set to true only if you deliberately
# want open registration back.
# ALLOW_SELF_REGISTRATION=true
